rules_version = '2';


service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access to all files (public website)
      allow read: if true;
      
      // Allow write access only to authenticated admin users
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
