rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Deny all access by default.
      // The RAFO website is currently a static site and does not use Firestore.
      // Enable specific rules here when Firestore functionality is added.
      allow read, write: if false;
    }
  }
}
